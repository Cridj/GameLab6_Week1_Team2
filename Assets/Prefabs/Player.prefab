--- !u!114 &4902440015397225055
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3811724953521094622}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB9D9\uC18C\uC0AC! \uD3C9\uC0DD \uD638\uD30D\uC744 \uCDB0\uC57C \uD558\uB294
    \uD638\uD30D \uBC14\uC774\uB7EC\uC2A4\uC5D0 \uAC10\uC5FC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uCE58\uB8CC\uC81C\uB97C
    \uD53C\uD574 \uB2EC\uC544\uB098\uBA70 \uBC14\uC774\uB7EC\uC2A4\uB97C \uD37C\uB728\uB9AC\uC138\uC694!\n\n\uC2B9\uB9AC
    \uC870\uAC74:\n\uAC01 \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C 1\uBD84 \uB3D9\uC548
    \uC0B4\uC544\uB0A8\uC73C\uBA70 \uBAA9\uD45C \uAC10\uC5FC\uB960\uC744 \uB2EC\uC131\uD558\uC2ED\uC2DC\uC624.\n\n\uC870\uC791\nA/D:
    \uD638\uD30D \uC2A4\uD15D (\uBC88\uAC08\uC544 \uD0C0\uAC74)\n\uB9C8\uC6B0\uC2A4
    \uC6C0\uC9C1\uC784: \uC2DC\uC810 \uBC0F \uBC29\uD5A5 \uC804\uD658\n\uB9C8\uC6B0\uC2A4
    \uC624\uB978\uCABD \uD074\uB9AD: \uB3CC\uC9C4 (\uD574\uAE08 \uD544\uC694)\n\uC2A4\uD398\uC774\uC2A4
    \uBC14: \uD3F4\uC9DD (\uD574\uAE08 \uD544\uC694)\n\n\uC801\n\uC2DC\uBBFC: \uBB34\uD574\uD55C
    \uC2DC\uBBFC\uC785\uB2C8\uB2E4.\n\uBA54\uB515: \uB9DE\uC73C\uBA74 \uCCB4\uB825\uC774
    1 \uAC10\uC18C\uD558\uB294 \uCE58\uB8CC\uC81C\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4.\n\uACBD\uCC30:
    \uACBD\uCC30\uC5D0\uAC8C \uC811\uCD09\uC2DC \uCCB4\uB825\uC774 1\uCE78 \uAC10\uC18C\uD569\uB2C8\uB2E4.\n\n\uC2A4\uD398\uC774\uC2A4
    \uBC14: \uAC8C\uC784 \uC2DC\uC791"
