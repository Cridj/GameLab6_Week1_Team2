  - MutationName: "\uC5ED\uC131\uC7A5"
    MutationDescription: "\uD50C\uB808\uC774\uC5B4\uC758 \uD06C\uAE30\uAC00 30% \uC791\uC544\uC9D1\uB2C8\uB2E4.\\n\uD638\uD30D
      \uC8FC\uB2C8\uC5B4\uC5D0\uAC8C\uB3C4 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB429\uB2C8\uB2E4."
    MutationCooldown: 
    MutationCost: 500
  - MutationName: "\uB354 \uB9CE\uC740 \uD3F4\uC9DD"
    MutationDescription: "\uD3F4\uC9DD\uC758 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774
      20% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    MutationCooldown: 
    MutationCost: 500
  - MutationName: "\uB354 \uB9CE\uC740 \uD264"
    MutationDescription: "\uD264\uC758 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774
      20% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    MutationCooldown: 
    MutationCost: 500
  - MutationName: "\uD3F4\uC9DD \uD574\uAE08"
    MutationDescription: "(\uC2A4\uD398\uC774\uC2A4 \uBC14 \uC0AC\uC6A9)\\n\uC18D\uB3C4\uB97C
      \uC720\uC9C0\uD558\uBA70 \uC55E\uC73C\uB85C \uB3C4\uC57D\uD569\uB2C8\uB2E4."
    MutationCooldown: 8
    MutationCost: 500
  UnlockMutationData:
  - MutationName: "\uB354 \uB9CE\uC740 \uB3CC\uC9C4"
    MutationDescription: "\uB3CC\uC9C4\uC758 \uC7AC\uC0AC\uC6A9 \uB300\uAE30\uC2DC\uAC04\uC774
      20% \uAC10\uC18C\uD569\uB2C8\uB2E4."
    MutationCooldown: 
    MutationCost: 500
  RareMutationData:
  - RareMutationName: "\uC708\uB4DC\uBC00"
    RareMutationDescription: "\uB3CC\uC9C4\uC744 \uC708\uB4DC\uBC00\uB85C \uBCC0\uACBD\uD569\uB2C8\uB2E4.
      \uC708\uB4DC\uBC00\uC740 \uB3CC\uC9C4\uD558\uB294 \uB3D9\uC548 \uC18D\uB3C4\uAC00
      \uC904\uC5B4\uB4DC\uB294 \uB300\uC2E0 \uD0C0\uACA9 \uBC94\uC704\uAC00 \uB298\uC5B4\uB0A9\uB2C8\uB2E4. "
    RareMutationCooldown: 
    RareMutationCost: 600
  - RareMutationName: It's-a me, Mario!
    RareMutationDescription: "\uD3F4\uC9DD\uC744 \uB9C8\uB9AC\uC624-\uD3F4\uC9DD\uC73C\uB85C
      \uBCC0\uACBD\uD569\uB2C8\uB2E4. \uB9C8\uB9AC\uC624-\uD3F4\uC9DD\uC73C\uB85C
      \uC801\uC744 \uBC1F\uC73C\uBA74 \uB2E4\uC2DC \uD55C\uBC88 \uB6F0\uC5B4\uC624\uB985\uB2C8\uB2E4."
    RareMutationCooldown: 
    RareMutationCost: 600
  - RareMutationName: "\uD3EC\uBCD1"
    RareMutationDescription: "\uD264\uC758 \uD22C\uC0AC\uCCB4\uAC00 \uD3EC\uBB3C\uC120
      \uC7A5\uAC70\uB9AC \uBC1C\uC0AC\uCCB4\uB85C \uBC14\uB01D\uB2C8\uB2E4. \uB5A8\uC5B4\uC9C4
      \uBC1C\uC0AC\uCCB4\uB294 \uD22C\uD558\uC9C0\uC810 \uBC18\uACBD\uC5D0 \uAC10\uC5FC\uC744
      \uC801\uC6A9\uD569\uB2C8\uB2E4."
    RareMutationCooldown: 
    RareMutationCost: 600
  - RareMutationName: "\uC2B9\uBD80\uC0AC"
    RareMutationDescription: "\uCCB4\uB825\uC774 \uD55C \uCE78\uC774 \uB429\uB2C8\uB2E4.
      \uB2E4\uC74C \uC2A4\uD14C\uC774\uC9C0 \uD074\uB9AC\uC5B4 \uC870\uAC74\uC774
      1\uBD84\uC5D0\uC11C 30\uCD08\uB85C \uC904\uC5B4\uB4E4\uACE0 \uC2A4\uD14C\uC774\uC9C0
      \uD074\uB9AC\uC5B4 \uD68D\uB4DD \uBCF4\uC0C1\uC774 2\uBC30\uAC00 \uB429\uB2C8\uB2E4."
    RareMutationCooldown: 
    RareMutationCost: 500
